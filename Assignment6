import json
import os
from datetime import datetime, timedelta #Importing and using Python Library

class Book:
    def __init__(self, book_id, title, author, available=True):
        self.book_id = book_id
        self.title = title
        self.author = author
        self.available = available

    def toggle_status(self):
        self.available = not self.available

library_inventory = {
        "B001": Book("B001", "It Ends With Us", "Colleen Hoover"),
        "B002": Book("B002", "Reminders of Him", "Colleen Hoover")
    }

print(f"---Library System Admin(Todays Date{datetime.now().strftime('%Y-%m-%d')})---")
print("1. View Inventory")
print("2. Process Checkout")

    # Handling invalid user input or runtime errors
try:
        choice = int(input("\nSelect an option (Numbers only): "))

        if choice == 1:
            for b_id, book in library_inventory.items():
                status = "Available" if book.available else "Checked Out"
                print(f"{b_id}: {book.title} by {book.author} - {status}")
        elif choice == 2:
            book_id = input("Enter the book ID to checkout: ")
            if book_id in library_inventory:
                if library_inventory[book_id].available:
                    library_inventory[book_id].toggle_status()
                    due_date = datetime.now() + timedelta(days=14) #Setting a due date for the checkout
                    print(f"Checkout successful! Due date: {due_date.strftime('%Y-%m-%d')}")
            else:
                print("Error: Book ID does not exist.")
            
        else:
            print("Please choose 1 or 2.")


except ValueError:
        print("Invalid Input Error: You must enter a numerical value for the menu selection.")
except Exception as error:
        print(f"An unexpected error occurred: {error}")