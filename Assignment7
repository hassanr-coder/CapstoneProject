# Option 2 Fetching and Displaying Data from an API

import requests
def fetch_book_by_isbn(isbn):

    # API endpoint URL with the ISBN parameter injected via f-string
    url = f"https://www.googleapis.com/books/v1/volumes?q=isbn:{isbn}"
    try:
        # Step 1: Send a GET request to the Google Books API

        response = requests.get(url)
        # Step 2: Convert the raw response data into a Python Dictionary (JSON parsing)
        data = response.json()

        # Step 3: Check if the 'items' key exists (indicating a book was found)

        if "items" in data:
            volume_info = data["items"][0]["volumeInfo"]
            title = volume_info.get("title", "Unknown Title")
            authors =", ".join(volume_info.get("authors", ["Unknown Author"]))
            print(f"Found{title} by {authors}")
            return{"title": title, "authors": authors} 
        else:
            print("No book found with that ISBN.")
        
    except Exception as e:
        # Error Handling: Catches connection issues or parsing errors gracefully
        print(f"API Error: {e}")
    return None    
