# Defining one class for the library inventory management system

class Book: 
    def __init__(self, book_id, title, author, available=True):
        self.book_id = book_id
        self.title = title
        self.author = author
        self.available = available


    def toggle_status(self):
        self.available = not self.available

    def to_dict(self):
        """Convert the Book object to a dictionary for JSON saving"""
        return {
            "title": self.title,
            "author": self.author,
            "available": self.available
        }
    
    # Instantiate and using objects in my program
    
library_inventory = {
      "B001": Book("B001", "It Ends With Us", "Colleen Hoover"),
      "B002": Book("B002", "Reminders of Him", "Colleen Hoover")
    }   
print("--Library OOP System--")
print("1. View Book Status")
print("2.Checkout/Return Book")
    
checkout_choice = input("\nSelect an option: ")     
    
if checkout_choice == "1":
        for book_id, book in library_inventory.items():
            status = "Available" if book.available else "Checked Out"
            print(f"ID: {book_id}, Title: {book.title}, Author: {book.author}, Status: {status}")
    
else:
        book_id = input("Enter the book ID to checkout/return: ")
        if book_id in library_inventory:
            library_inventory[book_id].toggle_status()
            new_status = "Available" if library_inventory[book_id].available else "Checked Out"
            print(f"{library_inventory[book_id].title} is now {new_status}.")
        else:
            print("Book Not Found.") 